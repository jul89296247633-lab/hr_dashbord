# ── Supabase (фронтенд + API routes) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Только сервер. НИКОГДА не передавать в браузер (см. CLAUDE.md).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Google Sheets API v4 ──────────────────────────────────────────────────
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_VACANCIES_TAB=Вакансии
GOOGLE_SHEETS_MANAGERS_TAB=HR менеджеры
GOOGLE_SHEETS_BONUSES_TAB=Бонусы_HR
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# ── HH CSV ────────────────────────────────────────────────────────────────
HH_CSV_ENCODING=windows-1251

# ── AI (Anthropic Messages API) ───────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (alert-уведомления admin) ────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
